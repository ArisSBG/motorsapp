# Configuration de PRODUCTION — copier en .env sur le serveur et remplir les valeurs vides.
# Ne jamais mettre ce fichier rempli dans Git.

APP_NAME="BURKINA MOTORS"
APP_ENV=production
APP_DEBUG=false
# Générer avec : php artisan key:generate — À SAUVEGARDER HORS DU SERVEUR (elle déchiffre les documents)
APP_KEY=
APP_URL=https://motorsapp.sacmh.bf

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Ouagadougou

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=burkina_motors
DB_USERNAME=burkina
# Mots de passe longs et aléatoires (32 caractères)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sessions : chiffrées, cookie envoyé seulement en HTTPS, fermées après 12 heures
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Adresse du proxy HTTPS de l'hébergeur (ou * si l'application n'est joignable que par lui)
# Site derrière Cloudflare : * si le serveur n’est joignable que par Cloudflare, sinon les plages IP de Cloudflare
TRUSTED_PROXIES=*

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Premier administrateur (seeder) : à retirer du fichier après la première installation
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sauvegardes chiffrées : mot de passe À SAUVEGARDER HORS DU SERVEUR
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=backups
BACKUP_MAIL_TO=

# Coordonnées imprimées sur les factures et reçus
ENTREPRISE_NOM="BURKINA MOTORS"
ENTREPRISE_ADRESSE="Koupéla, Burkina Faso"
ENTREPRISE_TELEPHONE="72 72 31 31"
ENTREPRISE_IFU=
ENTREPRISE_RCCM=
